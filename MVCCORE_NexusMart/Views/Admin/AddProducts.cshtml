@model MVCCORE_NexusMart.Models.ProductVM

@{
    ViewData["Title"] = "Add Products";
    Layout = "~/Views/Shared/_AdminDashboard.cshtml";
}

<h2 >ADD NEW PRODUCT</h2>

@if (ViewData["message"] != null)
{
    <div class="alert alert-danger">
        @ViewData["message"]
    </div>
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success">
        @TempData["message"]
    </div>
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddProducts" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Product_Name" class="control-label">Product Name</label>
                <input asp-for="Product_Name" class="form-control" />
                <span asp-validation-for="Product_Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Product_Price" class="control-label">Price</label>
                <input asp-for="Product_Price" class="form-control" type="number"  />
                <span asp-validation-for="Product_Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProductImageFile" class="control-label">Product Image</label>
                <input asp-for="ProductImageFile" type="file" class="form-control" />
                <span asp-validation-for="ProductImageFile" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Product_Description" class="control-label">Description</label>
                <textarea asp-for="Product_Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Product_Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category_Id" class="control-label">Category ID</label>
                <input asp-for="Category_Id" class="form-control" type="number" step="1" />
                <span asp-validation-for="Category_Id" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Add Product" class="btn btn-primary" />
               
            </div>
        </form>
    </div>
</div>
@if (ViewBag.RecentProducts != null)
{
    @await Html.PartialAsync("_ProductList", ViewBag.RecentProducts as IEnumerable<MVCCORE_NexusMart.Models.Product>)
}


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}