@model IEnumerable<Category>

<div class="card">
    <div class="card-header">
        <h5>Category List</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <ul class="list-group">
                @foreach (var item in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold">@item.Category_Id</span>: @item.Category_Name
                        </div>
                        <div>
                           
                                <a asp-controller="Admin" asp-action="EditCategory" asp-route-id="@item.Category_Id" class="btn btn-sm btn-outline-primary me-2">
                                <i  class="fas fa-edit"></i>
                            </a>
                            <a  asp-controller="Admin" asp-action="DeleteCategory" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                                </a>
                            
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No categories found.</p>
        }
    </div>
</div>